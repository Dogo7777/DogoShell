#!/usr/bin/env python3
"""Backend central de configurações e telemetria."""
import copy, json, os, re, subprocess, sys, platform, socket, getpass

HOME = os.environ.get("HOME", os.path.expanduser("~"))
CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))

STORE = os.path.join(CONFIG, "hypr", "settings.json")
LUA = os.path.join(CONFIG, "hypr", "settings.lua")
STYLE = os.path.join(CONFIG, "quickshell", "style.json")

DEFAULTS = {
    "shape": "round",
    "blur": True, "blur_size": 6, "blur_passes": 2,
    "shell_blur": True,
    "shadow": False,
    "opacity_active": 1.0, "opacity_inactive": 1.0,
    "gaps_in": 5, "gaps_out": 10, "gaps_top": 45, "border": 2,
    "anim_scale": 1.0, "border_spin": False,
    "layout": "dwindle",
    "sensitivity": 0.0,
    "natural_scroll": False,
    "cursor_size": 24,
    "focus_mouse": True,
    "bar_mode": "island",
    "bar_position": "top",
    "bar_full_width": False,
    "bar_floating": True,
    "bar_margin": 6,
    "bar_opacity": 0.55,
    "show_clock_date": False,
    "binds": {
        "terminal": "SUPER + Q",
        "filemanager": "SUPER + E",
        "launcher": "SUPER + R",
        "launcher2": "SUPER + SPACE",
        "wallpaper": "SUPER + W",
        "power": "SUPER + M",
        "lock": "SUPER + L",
        "settings": "SUPER + comma",
        "close": "SUPER + C",
        "float": "SUPER + V",
    },
}
SHAPES = {"round": (12, 1.0), "soft": (6, 0.5), "square": (0, 0.0)}

def load():
    cur = copy.deepcopy(DEFAULTS)
    try:
        if os.path.exists(STORE):
            with open(STORE, encoding="utf-8") as f:
                saved = json.load(f)
            for k, v in saved.items():
                if k == "binds" and isinstance(v, dict):
                    cur["binds"].update({a: b for a, b in v.items() if a in cur["binds"]})
                elif k in cur:
                    cur[k] = v
    except Exception:
        pass
    return cur

def lua(o, ind=0):
    pad = "    " * (ind + 1)
    if isinstance(o, bool): return "true" if o else "false"
    if isinstance(o, (int, float)): return repr(o)
    if isinstance(o, str): return json.dumps(o, ensure_ascii=False)
    if isinstance(o, dict):
        rows = [f"{pad}{k if re.match(r'^[A-Za-z_]\w*$', k) else json.dumps(k)} = {lua(v, ind + 1)}," for k, v in o.items()]
        return "{\n" + "\n".join(rows) + "\n" + "    " * ind + "}"
    raise TypeError(type(o))

def write_all(s):
    rounding, scale = SHAPES.get(s["shape"], SHAPES["round"])
    out = {
        "rounding": rounding,
        "border": int(s["border"]),
        "gaps_in": int(s["gaps_in"]),
        "gaps_out": {"top": int(s["gaps_top"]), "right": int(s["gaps_out"]),
                     "bottom": int(s["gaps_out"]), "left": int(s["gaps_out"])},
        "blur": bool(s["blur"]),
        "blur_size": int(s["blur_size"]),
        "blur_passes": int(s["blur_passes"]),
        "shell_blur": bool(s["shell_blur"]),
        "shadow": bool(s["shadow"]),
        "opacity_active": float(s["opacity_active"]),
        "opacity_inactive": float(s["opacity_inactive"]),
        "anim_scale": float(s["anim_scale"]),
        "border_spin": bool(s["border_spin"]),
        "layout": str(s["layout"]),
        "sensitivity": float(s["sensitivity"]),
        "natural_scroll": bool(s["natural_scroll"]),
        "cursor_size": int(s["cursor_size"]),
        "focus_mouse": bool(s["focus_mouse"]),
        "binds": s["binds"],
    }
    style_out = {
        "scale": scale,
        "bar_mode": str(s.get("bar_mode", "island")),
        "bar_position": str(s.get("bar_position", "top")),
        "bar_full_width": bool(s.get("bar_full_width", False)),
        "bar_floating": bool(s.get("bar_floating", True)),
        "bar_margin": int(s.get("bar_margin", 6)),
        "bar_opacity": float(s.get("bar_opacity", 0.55)),
        "show_clock_date": bool(s.get("show_clock_date", False)),
    }
    for path in (STORE, LUA, STYLE):
        os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(STORE, "w", encoding="utf-8") as f: json.dump(s, f, indent=2, ensure_ascii=False)
    with open(LUA, "w", encoding="utf-8") as f: f.write("-- gerado por nyos-settings\nreturn " + lua(out) + "\n")
    with open(STYLE, "w", encoding="utf-8") as f: json.dump(style_out, f, indent=2)

def reload_services(s, key_changed):
    rounding, _ = SHAPES.get(s.get("shape", "round"), SHAPES["round"])
    kw_map = {
        "shape": [["decoration:rounding", str(rounding)]],
        "border": [["general:border_size", str(int(s.get("border", 2)))]],
        "gaps_in": [["general:gaps_in", str(int(s.get("gaps_in", 5)))]],
        "gaps_out": [["general:gaps_out", f"{int(s.get('gaps_top', 45))} {int(s.get('gaps_out', 10))} {int(s.get('gaps_out', 10))} {int(s.get('gaps_out', 10))}"]],
        "gaps_top": [["general:gaps_out", f"{int(s.get('gaps_top', 45))} {int(s.get('gaps_out', 10))} {int(s.get('gaps_out', 10))} {int(s.get('gaps_out', 10))}"]],
        "blur": [["decoration:blur:enabled", "1" if s.get("blur") else "0"]],
        "blur_size": [["decoration:blur:size", str(int(s.get("blur_size", 6)))]],
        "blur_passes": [["decoration:blur:passes", str(int(s.get("blur_passes", 2)))]],
        "shadow": [["decoration:shadow:enabled", "1" if s.get("shadow") else "0"]],
        "opacity_active": [["decoration:active_opacity", str(float(s.get("opacity_active", 1.0)))]],
        "opacity_inactive": [["decoration:inactive_opacity", str(float(s.get("opacity_inactive", 1.0)))]],
        "layout": [["general:layout", str(s.get("layout", "dwindle"))]],
        "sensitivity": [["input:sensitivity", str(float(s.get("sensitivity", 0.0)))]],
        "natural_scroll": [["input:touchpad:natural_scroll", "1" if s.get("natural_scroll") else "0"]],
        "focus_mouse": [["input:follow_mouse", "1" if s.get("focus_mouse", True) else "0"]],
    }

    if key_changed in kw_map:
        for cmd_args in kw_map[key_changed]:
            try: subprocess.run(["hyprctl", "keyword"] + cmd_args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception: pass

    if key_changed in kw_map:
        try: subprocess.run(["hyprctl", "reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception: pass

    if key_changed.startswith("bar_") or key_changed in ("show_clock_date", "shape"):
        try:
            pids = subprocess.check_output("ps aux | grep -E 'quickshell.*island|qs.*island' | grep -v grep | grep -v settings | awk '{print $2}'", shell=True, text=True).strip().split()
            for pid in pids:
                if pid: subprocess.run(["kill", "-9", pid], check=False)
            subprocess.Popen(["qs", "-c", "island"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except Exception: pass

def get_sysinfo():
    cpu = "Intel / AMD Processor"
    try:
        with open("/proc/cpuinfo") as f:
            for l in f:
                if "model name" in l: cpu = re.sub(r"\s+", " ", l.split(":")[1].strip()); break
    except Exception: pass

    gpu = "AMD / NVIDIA GPU"
    try:
        out = subprocess.check_output("lspci | grep -E 'VGA|3D|Display'", shell=True, text=True).strip()
        if out: gpu = out.split(":", 2)[-1].strip()
    except Exception: pass

    ram = "N/A"
    try:
        with open("/proc/meminfo") as f:
            m = {l.split(":")[0].strip(): l.split(":")[1].strip() for l in f if ":" in l}
        tot = int(m.get("MemTotal", "0 kB").split()[0])
        avail = int(m.get("MemAvailable", "0 kB").split()[0])
        ram = f"{(tot - avail) / 1048576:.1f} GB / {tot / 1048576:.1f} GB"
    except Exception: pass

    uptime = "N/A"
    try:
        with open("/proc/uptime") as f:
            sec = float(f.readline().split()[0])
            uptime = f"{int(sec // 3600)}h {int((sec % 3600) // 60)}m"
    except Exception: pass

    return {
        "user": getpass.getuser(),
        "hostname": socket.gethostname(),
        "distro": "Linux",
        "kernel": platform.release(),
        "uptime": uptime,
        "hypr_ver": "Hyprland",
        "qs_ver": "Quickshell",
        "cpu": cpu,
        "gpu": gpu,
        "ram": ram,
        "avatar": "",
        "dotfiles_ver": "v2.0 (HyprAtomic)",
    }

def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "get"
    if cmd == "sysinfo":
        print(json.dumps(get_sysinfo(), ensure_ascii=False))
        return
    s = load()
    if cmd == "get":
        print(json.dumps(s, ensure_ascii=False))
        return
    k = ""
    if (cmd in ("set", "apply")) and len(a) >= 3:
        k, v = a[1], json.loads(a[2])
        if k == "binds" and isinstance(v, dict): s["binds"].update(v)
        elif k in s: s[k] = v
    elif cmd == "reset":
        s = copy.deepcopy(DEFAULTS)
    write_all(s)
    if cmd in ("set", "apply") and k:
        reload_services(s, k)

if __name__ == "__main__":
    main()
